# ============================================================
# KURMON — SMK Karya Guna 2 | Contoh konfigurasi .env
# Salin file ini ke .env lalu isi nilainya sebelum menjalankan server.
# JANGAN commit file .env ke Git!
# ============================================================

# ── Database PostgreSQL ──────────────────────────────────────
PG_USER=postgres
PG_PASSWORD=kurmon_db_password_kuat_123!
PG_DATABASE=school_system_db
PG_HOST=127.0.0.1
PG_PORT=5432

# ── Secret Keys WAJIB (server tidak akan start jika kosong) ──
# Generate dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# Digunakan untuk enkripsi/dekripsi password mesin Hikvision IoT
APP_KEY=ganti_dengan_random_hex_minimal_48_karakter

# Digunakan untuk tanda tangan digital token kartu pelajar
# Bisa pakai CARD_SECRET_KEY atau JWT_SECRET (salah satu cukup)
CARD_SECRET_KEY=ganti_dengan_random_hex_minimal_48_karakter

# ── Konfigurasi Opsional ─────────────────────────────────────

# Default password admin pertama kali (kosongkan setelah setup)
# DEFAULT_ADMIN_PASSWORD=

# Port server backend (default: 3030)
# AUTH_PORT=3030

# Origin frontend yang diizinkan (pisah koma/spasi)
# AUTH_ALLOWED_ORIGINS=http://localhost:6677,http://192.168.1.100:6677

# Set ke 'true' jika server di belakang reverse proxy (Nginx/Caddy)
# agar IP dari X-Forwarded-For dipercaya untuk audit log
# TRUST_PROXY=false

# ── Integrasi Telegram Bot ───────────────────────────────────
# CATATAN: Token Telegram Bot TIDAK perlu diisi di sini.
# Login sebagai Admin → menu "Manajemen API Key" →
# tambahkan service_name "telegram_bot_monitor" dengan token dari @BotFather.

# ── Integrasi WhatsApp (Fonnte) ──────────────────────────────
# Sama seperti Telegram — kelola via menu "Manajemen API Key" di aplikasi.

